    <string name="setup_storage_title">Storage access</string>
    <string name="setup_storage_body">Allow access to scan readable files in shared storage for known local signatures. Android still restricts access to some system and app-private locations; this does not inspect every file on the device.</string>
    <string name="setup_apps_title">Installed-app visibility</string>
