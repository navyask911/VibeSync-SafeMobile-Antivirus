<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="download_interceptor_label">下載監控</string>
    <string name="download_interceptor_description">利用可訪問的下載和 MediaStore 條目，在系統允許範圍內監控新 APK/EXE。Android 控制安裝過程；SafeMobile 無法阻止所有安裝提示。</string>
    <string name="download_interceptor_status_enabled">下載監控已啟用，前臺服務正在執行。</string>
    <string name="download_interceptor_status_setup">啟用下載監控並授予儲存訪問許可權以開始監控。</string>
    <string name="download_interceptor_status_disabled">下載監控已關閉。請啟用以開始監控。</string>
    <string name="strict_mode_label">嚴格模式</string>
    <string name="strict_mode_description">在支持的情況下，將未知或未經驗證的 APK/EXE 下載移入加密隔離區。檔案仍可恢復，SafeMobile 不會永久刪除它們。</string>
    <string name="download_sentinel_running">下載監控前臺服務正在執行。</string>
    <string name="download_sentinel_stopped">下載監控前臺服務未執行。</string>
    <string name="blocked_activity_title_confirmed">SafeMobile 下載監控發現惡意下載。</string>
    <string name="blocked_activity_title_interrupted">Android 已開啟安裝程式。下載監控無法可靠阻止安裝提示。</string>
    <string name="blocked_activity_title_review">下載需要複核</string>
    <string name="blocked_activity_title_quarantine">下載已移入隔離區</string>
    <string name="blocked_activity_body">SafeMobile 在裝置上檢查可訪問的下載檔案，並記錄本地安全事件。Android 決定應用是否安裝。</string>
