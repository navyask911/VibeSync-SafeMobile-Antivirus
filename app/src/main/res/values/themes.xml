<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SafeMobile" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/safe_cyan</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/safe_navy</item>
    </style>

    <style name="Theme.SafeMobile.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/safe_cyan</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F4F7FA</item>
    </style>

    <style name="Theme.SafeMobile.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/vibesync_official_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#FFFFFF</item>
        <item name="postSplashScreenTheme">@style/Theme.SafeMobile</item>
        <item name="android:windowBackground">#FFFFFF</item>
    </style>
</resources>
